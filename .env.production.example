# AegisAI Production Environment Configuration
# Copy to .env and fill in with secure values
# Generate secrets with: openssl rand -hex 32

# ==========================================
# Application Settings
# ==========================================
APP_NAME=AegisAI
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# ==========================================
# Database (PostgreSQL)
# ==========================================
POSTGRES_USER=aegisai
POSTGRES_PASSWORD=CHANGE_ME_USE_SECRET_MANAGER
POSTGRES_DB=aegisai
DATABASE_URL=postgresql+asyncpg://aegisai:CHANGE_ME_USE_SECRET_MANAGER@postgres:5432/aegisai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ==========================================
# Security (JWT)
# ==========================================
# Generate: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_SECURE_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# CORS Settings
# ==========================================
CORS_ORIGINS=["http://localhost:80","http://localhost:5173"]

# ==========================================
# Qdrant Vector Database
# ==========================================
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=aegisai_documents

# ==========================================
# Ollama LLM Settings
# ==========================================
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# ==========================================
# RAG Settings
# ==========================================
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RESULTS=5

# ==========================================
# Hybrid RAG (opt-in; default false preserves legacy behavior)
# ==========================================
# Set HYBRID_RAG_ENABLED=true to enable vector+BM25 → RRF → cross-encoder rerank.
# Per-request override: POST /api/v1/chat { ..., "enable_hybrid": true/false }.
HYBRID_RAG_ENABLED=false
BM25_K1=1.5
BM25_B=0.75
VECTOR_TOP_K=20
BM25_TOP_K=20
FUSION_TOP_K=12
RRF_K=60
RERANK_TOP_K=5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MAX_CONTEXT_CHARS=12000
CITATION_VALIDATION_ENABLED=true

# ==========================================
# Phase 2 Advanced RAG (all opt-in, backward compatible)
# ==========================================
# Master switch — when false, all Phase 2 features are off regardless of sub-flags.
PHASE2_ENABLED=false
PHASE2_MULTI_QUERY_ENABLED=false
PHASE2_QUERY_REWRITE_ENABLED=false
PHASE2_QUERY_EXPANSION_ENABLED=false
PHASE2_DECOMPOSITION_ENABLED=false
PHASE2_DIVERSITY_ENABLED=false
PHASE2_DIVERSITY_MAX_PER_DOC=3
PHASE2_ADJACENT_EXPANSION_ENABLED=false
PHASE2_ADJACENT_THRESHOLD=0.7
PHASE2_VERSION_HANDLING_ENABLED=false
PHASE2_CONFLICT_DETECTION_ENABLED=true
PHASE2_COVERAGE_ENABLED=true
PHASE2_PROMPT_DEFENSE_ENABLED=true
PHASE2_TABLE_HANDLING_ENABLED=true

# ==========================================
# File Upload Settings
# ==========================================
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=[".pdf",".docx",".txt",".md"]
UPLOAD_DIR=/app/uploads

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=INFO
LOG_FORMAT=json